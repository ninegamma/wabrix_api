package wabrix:plugins@0.1.0;
    
/// The interface for nodes that inspect and modify packets, e.g. running a TCP stack.
interface packet-engine {
    /// A cumulative histogram metric reported by a packet-engine plugin.
    record histogram {
        name: string,
        sum: u64,
        count: u64,
        buckets: list<u64>,
    }

    record counter {
        name: string,
        value: u64,
    }

    /// A telemetry payload can contain ordinary counters and structured metrics.
    variant telemetry-metric {
        counter(counter),
        hist(histogram),
    }

    /// Exact timer workload requested for the next batch.
    record timer-plan {
        timeout-frames: u32,
        packet-frames: u32,
    }

    /// Called once at startup with admin key/value data from the node config (node_data field)
    init-data: func(data: list<tuple<string, string>>, tsc-frequency: u64) -> bool;

    /// Zero-copy batch processing via the shared UMEM mailbox.
    /// The host writes desc_addrs/lengths into the mailbox before calling; the plugin
    /// writes actions/new_lengths into the same mailbox and returns a status code (0 = OK).
    process-batch: func(batch-size: u32, umem-offset: u32, mailbox-offset: u32) -> u32;

    /// Process timers and return the timeout/SYN frame split for the next batch.
    process-timers: func(current-tsc: u64) -> timer-plan;

    // The universal control event receiver
    on-control-event: func(opcode: u32, payload: list<u8>) -> bool;

    /// Returns out-of-band telemetry. Counter entries retain their configured
    /// order; structured metrics may appear alongside them. An empty list
    /// means that no telemetry snapshot is available for this poll.
    get-telemetry: func() -> list<telemetry-metric>;
}

interface logging {
    log: func(level: u32, message: string);
}

/// The interface for nodes that generate new synthetic traffic.
interface generator {
    /// Called once at startup with admin key/value data from the node config (node_data field)
    /// and to set the worker ID and internal sequence state
    init-data: func(data: list<tuple<string, string>>, worker-id: u32);

    // Define aliases for readability
    type ipv4-addr = tuple<u8, u8, u8, u8>;
    type mac-addr = tuple<u8, u8, u8, u8, u8, u8>;
    set-dst: func(mac: mac-addr, ip: ipv4-addr);

    /// Takes an empty batch of PDUs, writes headers, returns packet lengths
    generate-batch: func(batch-bytes: list<u8>, umem-offset: u32) -> list<u32>;
}

/// The World definition for a Generator plugin
world generator-plugin {
    export generator;
}

/// The World definition for a generic WASM engine plugin
world engine-plugin {
    export packet-engine;
    import logging;
}
